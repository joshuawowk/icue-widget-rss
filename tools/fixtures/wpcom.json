{"found":58312,"posts":[{"ID":1155770,"author":{"ID":104030207,"login":"dp2cnk","email":false,"name":"Donald Papp","first_name":"Donald","last_name":"Papp","nice_name":"dp2cnk","URL":"","avatar_URL":"https://secure.gravatar.com/avatar/2e935971e285f4fd37cbf57560eeb4a90ab1b195f1955b3f388699c4a6d50a78?s=96&d=mm","profile_URL":"https://gravatar.com/15249ee465ed3171ac124e70565ed819"},"date":"2026-09-10T08:30:16-07:00","title":"Custom AMOLED Wearable Makes Great Icebreaker","URL":"https://hackaday.com/2026/09/10/custom-amoled-wearable-makes-great-icebreaker/","excerpt":"<p>Nifty little AMOLED screens are easy to get nowadays, and [Sophie D] demonstrates they are both thin and light enough to be worn with OpenChoker, a design for a choker <a href=\"https://hackaday.com/2026/09/10/custom-amoled-wearable-makes-great-icebreaker/\" class=\"read-more\">&hellip;read more</a></p>\n","featured_image":"https://hackaday.com/wp-content/uploads/2026/09/OLED-choker.png","categories":{"LED Hacks":{"ID":422573557,"name":"LED Hacks","slug":"led-hacks","description":"","post_count":1946,"meta":{"links":{"self":"https://public-api.wordpress.com/rest/v1.1/sites/156670177/categories/slug:led-hacks","help":"https://public-api.wordpress.com/rest/v1.1/sites/156670177/categories/slug:led-hacks/help","site":"https://public-api.wordpress.com/rest/v1.1/sites/156670177"}},"parent":0},"Wearable Hacks":{"ID":12552193,"name":"Wearable Hacks","slug":"wearable-hacks","description":"","post_count":869,"meta":{"links":{"self":"https://public-api.wordpress.com/rest/v1.1/sites/156670177/categories/slug:wearable-hacks","help":"https://public-api.wordpress.com/rest/v1.1/sites/156670177/categories/slug:wearable-hacks/help","site":"https://public-api.wordpress.com/rest/v1.1/sites/156670177"}},"parent":0}}},{"ID":1160435,"author":{"ID":3023018,"login":"wd5gnr1","email":false,"name":"Al Williams","first_name":"Al","last_name":"Williams","nice_name":"wd5gnr1","URL":"","avatar_URL":"https://secure.gravatar.com/avatar